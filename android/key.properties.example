# Copy this file to android/key.properties and fill in your release keystore details.
# key.properties is gitignored (never commit signing secrets).
#
# storeFile may be an absolute path (C:/path/to/your.jks) or a path relative to android/.
storeFile=C:/path/to/your-release-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=memosystem
keyPassword=YOUR_KEY_PASSWORD
